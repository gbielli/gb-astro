---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---
<figure class="my-6">
  <Image src={src} alt={alt} />
  {caption && (
    <figcaption class="text-sm text-gray-500 text-center italic mt-2">
      {caption}
    </figcaption>
  )}
</figure>
