---
// Callout.astro
import { AlertCircle, AlertTriangle, Info, Lightbulb } from 'lucide-react';

interface Props {
  type?: 'info' | 'warning' | 'error' | 'tip';
  title?: string;
}

const { type = 'info', title }: Props = Astro.props;

const styles = {
  info: {
    borderClass: 'border-blue-200',
    iconClass: 'text-blue-500',
    markerClass: 'marker:text-blue-500',
    Icon: Info
  },
  warning: {
    borderClass: 'border-amber-200',
    iconClass: 'text-amber-500',
    markerClass: 'marker:text-amber-500',
    Icon: AlertTriangle
  },
  error: {
    borderClass: 'border-rose-200',
    iconClass: 'text-rose-500',
    markerClass: 'marker:text-rose-500',
    Icon: AlertCircle
  },
  tip: {
    borderClass: 'border-emerald-200',
    iconClass: 'text-emerald-500',
    markerClass: 'marker:text-emerald-500',
    Icon: Lightbulb
  }
};

const { borderClass, iconClass, markerClass, Icon } = styles[type];
---
<div class={`callout-box relative bg-[#f8f8f8] border-2 border-dashed rounded-2xl pt-8 pb-6 px-6 mt-10 mb-6 ${borderClass}`}>
  <div class={`icon-float absolute -top-7 left-5 w-14 h-14 rounded-full bg-[#f8f8f8] flex items-center justify-center ${iconClass}`}>
    <Icon size={30} strokeWidth={1.6} />
  </div>
  {title && <p class="callout-title font-archivo font-semibold text-[17px] text-zinc-900 mb-2">{title}</p>}
  <div class={`callout-content text-zinc-600 ${markerClass}`}>
    <slot />
  </div>
</div>

<style>
  @reference "../styles/global.css";

  .callout-content :global(p) {
    @apply m-0 text-lg;
  }

  .callout-content :global(p + p) {
    @apply mt-3;
  }
</style>
